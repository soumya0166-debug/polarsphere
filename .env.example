# ==============================================================================
# POLARSPHERE — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: "The Polar World, Through India's Eyes"
# ==============================================================================

# Supabase PostgreSQL Configuration (Optional for Local Dev, Required for Production Cloud DB)
# When provided, PolarSphere dynamically queries the live Supabase database.
# When empty or omitted, PolarSphere automatically falls back to the in-memory relational store.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# API Base URL (if using external gateway or serverless functions)
VITE_API_BASE_URL=

# Development Data Engine:
# 'true' enables automatic schema-compliant mock fixture fallback when remote DB is offline.
VITE_ENABLE_MOCK_FALLBACK=true

# Ingestion Pipeline Settings
VITE_INGESTION_VERSION=v1.0.0-phase1
VITE_APP_ENV=development
